[Unit]
Description=Qdrant Local Vector Search Engine
After=network.target

[Service]
Type=exec
User=nathan
Group=nathan
EnvironmentFile=-/etc/labish/qdrant.env
ExecStart=/usr/local/bin/qdrant
Restart=always
RestartSec=3

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
