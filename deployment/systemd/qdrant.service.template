[Unit]
Description=Qdrant Local Vector Search Engine
After=network.target

[Service]
Type=exec
User=${LABISH_USER}
Group=${LABISH_GROUP}
WorkingDirectory=${QDRANT_DATA_DIR}
EnvironmentFile=-/etc/labish/qdrant.env
ExecStart=${QDRANT_BINARY}
Restart=always
RestartSec=3

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
