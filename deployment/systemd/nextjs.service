[Unit]
Description=Labish Next.js Web Frontend Server Node Process
After=network.target fastapi.service
Wants=fastapi.service

[Service]
Type=exec
User=nathan
Group=nathan
WorkingDirectory=/home/nathan/my-application/apps/web
# NEXT_PUBLIC_SITE_URL, API_URL, NODE_ENV, PORT, ... live here.
EnvironmentFile=/etc/labish/web.env
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=3

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
