# Labish production reverse proxy (template).
# Rendered by apps/api/app/setup.py with the real server_name and
# installed as /etc/nginx/sites-available/labish (symlinked into
# sites-enabled). ${SERVER_NAME} is substituted at install time.

upstream labish_api {
    server 127.0.0.1:8000;
    keepalive 32;
}

upstream labish_web {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80;
    server_name ${SERVER_NAME};

    # Baseline hardening.
    server_tokens off;
    client_max_body_size 10m;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;
    gzip_min_length 1024;

    # FastAPI system layer: API and auth traffic.
    location ~ ^/(api|auth|health|openapi\.json)(/|$) {
        # Strip the optional /api prefix so /api/auth/login reaches
        # the backend as /auth/login.
        rewrite ^/api(/.*)$ $1 break;

        proxy_pass http://labish_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Correlate edge requests with the backend request-metadata
        # middleware (X-Request-ID / X-Response-Time-Ms).
        proxy_set_header X-Request-ID $request_id;
        add_header X-Edge-Request-ID $request_id always;

        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    # Next.js production rendering engine: everything else.
    location / {
        proxy_pass http://labish_web;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_cache_bypass $http_upgrade;
    }
}
