# dependencies
/node_modules
/apps/web/node_modules
apps/api/.venv/
apps/api/**/__pycache__/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
apps/api/.pytest_cache/

